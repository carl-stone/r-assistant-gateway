{
  "name": "r-assistant-gateway",
  "version": "0.3.0",
  "description": "Unofficial local gateway from Posit Assistant in RStudio and Positron to ChatGPT/Codex OAuth",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Carl Stone",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carl-stone/r-assistant-gateway.git"
  },
  "homepage": "https://github.com/carl-stone/r-assistant-gateway#readme",
  "bugs": "https://github.com/carl-stone/r-assistant-gateway/issues",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "r-assistant-gateway": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check:contract": "tsx scripts/check-contract.ts",
    "lint": "biome check src test scripts",
    "prepack": "npm run verify",
    "test": "vitest run",
    "test:cli": "tsx scripts/test-cli-lifecycle.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:cli"
  },
  "dependencies": {
    "openai-oauth": "npm:@carl-stone/openai-oauth@2.0.0-memory.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "r",
    "data-science",
    "ai-assistant",
    "responses-api",
    "oauth",
    "gateway"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
